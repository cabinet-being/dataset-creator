{
  "name": "dataset-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test:project-types": "node tests/project-types.mjs",
    "test:workspace-layout": "node tests/workspace-layout.mjs",
    "test:video-frames": "node tests/video-frames.mjs",
    "test:ui-workflows": "node tests/ui-workflows.mjs",
    "test:dataset-assembly": "node tests/dataset-assembly.mjs",
    "test:browser-fixtures": "vite build --config vite.browser.config.ts",
    "test:browser": "npm run test:browser-fixtures && playwright test",
    "test:browser:network": "npm run test:browser-fixtures && playwright test --grep @network --workers=1",
    "test:service-boundaries": "node tests/service-boundaries.mjs",
    "test:state-recovery": "node tests/state-recovery.mjs",
    "test:similarity": "node tests/similarity-levels.mjs",
    "test:quality-metrics": "node tests/quality-metrics.mjs",
    "test:model-download": "node tests/model-download.mjs",
    "test:caption-txt": "node tests/caption-txt.mjs",
    "test": "npm run test:project-types && npm run test:workspace-layout && npm run test:video-frames && npm run test:ui-workflows && npm run test:dataset-assembly && npm run test:service-boundaries && npm run test:state-recovery && npm run test:similarity && npm run test:quality-metrics && npm run test:model-download && npm run test:caption-txt",
    "test:ci": "npm run lint && npm run test:docs && npm test && npm run build && npm run test:browser",
    "test:docs": "node tests/docs-checker.mjs && node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "ag-psd": "^31.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.310.0",
    "mediabunny": "1.61.0",
    "onnxruntime-web": "^1.24.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.2",
    "uuid": "^14.0.1",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.4.32",
    "rolldown": "^1.2.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.2.0"
  }
}
